# Single source of truth for the backend connection. Every other backend-derived
# value (auth mutations, abandoned-cart tracking endpoint, live shop currency, payment
# gateway availability) is derived from this one URL's origin — see lib/env.ts. Point
# it at your WPGraphQL endpoint, e.g.:
VITE_GRAPHQL_ENDPOINT=
#
# The Vite development server defaults to https://v1.superfunky.pro/graphql when this
# is empty. Production builds intentionally have no default and require this variable.

# Stripe publishable key (test or live) — set this to render the real
# @stripe/react-stripe-js Payment Element on the checkout page's "Pay online with
# card" option. Left unset, the checkout page shows a "connect Stripe" notice instead.
#
# IMPORTANT: only the *publishable* key (pk_...) ever belongs here. The Stripe
# *secret* key must NEVER be set in this frontend, in any .env file, or committed
# anywhere in this repo — it is configured once in wp-admin under WooCommerce →
# Settings → Payments → Stripe (the WooCommerce Stripe Gateway plugin), which is what
# lib/payments.ts's checkout submission actually talks to via the WooCommerce Store
# API. This frontend never creates PaymentIntents or touches the secret key directly.
VITE_STRIPE_PUBLISHABLE_KEY=

# Edge/CDN geolocation endpoint (see lib/geolocation.ts) — typically injected by the
# hosting platform (e.g. Netlify's /geolocation) rather than the WP backend itself, so
# it stays a separate env var.
VITE_GEOLOCATION_ENDPOINT=
