# Single source of truth for the backend connection. Every other backend-derived
# value (auth mutations, abandoned-cart tracking endpoint, live shop currency, payment
# gateway availability) is derived from this one URL's origin — see lib/env.ts. Point
# it at your WPGraphQL endpoint, e.g.:
VITE_GRAPHQL_ENDPOINT=
#
# Optional direct URL to the static Tailwind class manifest generated by the
# Optional static Tailwind manifest for deployments that publish one independently.
# Superfunky production leaves this empty and compiles only the reviewed local
# contract, performing no CMS Tailwind inventory request. A configured manifest
# fails before Vite when unavailable, incomplete, or invalid.
VITE_CMS_TAILWIND_MANIFEST_URL=
#
# Preferred incremental mode: a signed, read-only source endpoint. Requires
# STOREFRONT_ARTIFACT_SIGNING_SECRET and VITE_SITE_URL. The build downloads the
# previous deployed index, fetches only changed source bodies, and publishes the
# next index with the successful deployment.
CMS_TAILWIND_SOURCE_API_URL=
# Set only for the first deployment when no previous index exists. A successful
# deployment publishes the index; remove this flag afterward.
CMS_TAILWIND_BOOTSTRAP=false
#
# Development and production builds default to the public
# https://dev.superfunky.pro/graphql reference backend when this is empty. Set an
# explicit endpoint for every customer or production deployment.
#
# Web Push subscribe, unsubscribe, and VAPID public-key routes are derived from this
# backend origin. The Stripe publishable key is likewise supplied by backend store
# settings. Private VAPID and Stripe keys must never be exposed to the frontend.

# Edge/CDN geolocation endpoint (see lib/geolocation.ts) — typically injected by the
# hosting platform (e.g. Netlify's /geolocation) rather than the WP backend itself, so
# it stays a separate env var.
VITE_GEOLOCATION_ENDPOINT=
