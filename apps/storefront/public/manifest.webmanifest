{
  "name": "Superfunky",
  "short_name": "Superfunky",
  "description": "A modern storefront experience — shop, journal, and account, installable as an app with offline support and push notifications.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#fafafa",
  "theme_color": "#7c4dff",
  "lang": "en",
  "dir": "ltr",
  "categories": ["shopping", "lifestyle"],
  "icons": [
    { "src": "/icons/app/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/app/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/app/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/app/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Shop",
      "short_name": "Shop",
      "description": "Browse the catalog",
      "url": "/shop?source=pwa-shortcut",
      "icons": [{ "src": "/icons/app/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Cart",
      "short_name": "Cart",
      "description": "View your cart",
      "url": "/cart?source=pwa-shortcut",
      "icons": [{ "src": "/icons/app/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Account",
      "short_name": "Account",
      "description": "Orders, addresses, and settings",
      "url": "/account?source=pwa-shortcut",
      "icons": [{ "src": "/icons/app/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
